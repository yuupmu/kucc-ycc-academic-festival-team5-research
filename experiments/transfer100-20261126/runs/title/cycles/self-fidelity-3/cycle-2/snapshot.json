    "files": {
      "solution.py": "import re\n\ndef clean_title(text: str) -> str:\n    # 1. 양끝 공백 제거 (P2)\n    text = text.rstrip()\n    \n    # 2. 영문자 소문자화, 숫자 유지 (P2)\n    text = text.lower()\n    \n    # 3. 연속된 공백은 하나의 공백으로 통일 (P2, P3)\n    # 하이픈은 정규식에서 제외하여 연속된 하이픈을 유지 (H1)\n    text = re.sub(r'(?<!-)\\s+(?!\\s*-)', ' ', text)\n    \n    # 4. 앞뒤 공백 제거 (P2, P3)\n    text = text.strip()\n    \n    return text"
    },
