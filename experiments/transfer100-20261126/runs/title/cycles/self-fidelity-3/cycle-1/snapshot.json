  "files": {
    "solution.py": "def clean_title(text: str) -> str:\n    # 1. 양끝 공백 제거\n    text = text.rstrip()\n    \n    # 2. 영문자 소문자화, 숫자 유지\n    text = text.lower()\n    \n    # 3. 연속된 공백은 하나의 공백으로 통일 (하이픈은 제외)\n    # 정규식: 하나 이상의 공백 (\\s+) 을 하나의 공백으로 치환\n    text = re.sub(r'\\s+', ' ', text)\n    \n    # 4. 하이픈은 개수와 위치를 그대로 유지 (P1, H1)\n    # 연속된 하이픈은 그대로 유지함 (예: 'hello--world' -> 'hello--world')\n    \n    # 5. 결과 앞뒤 공백 제거 (안전성 확보)\n    text = text.strip()\n    \n    return text\n\nimport re"
  },
