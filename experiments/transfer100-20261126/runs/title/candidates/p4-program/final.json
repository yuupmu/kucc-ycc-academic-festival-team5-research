    "files": {
      "solution.py": "def clean_title(text: str) -> str:\n    # 1. 양끝 공백 제거 및 영문자 소문자화, 숫자 유지\n    text = text.rstrip().lower()\n    \n    # 2. 연속된 내부 공백을 하나로 줄임 (H2)\n    text = re.sub(r'\\s+', ' ', text)\n    \n    # 3. 하이픈은 개수와 위치를 그대로 유지함 (H1)\n    # 빈 문자열은 이미 rstrip 처리 후 빈 문자열로 유지됨\n    \n    return text\n\nimport re"
    },
