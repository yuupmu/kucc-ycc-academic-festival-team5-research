      "solution.py": "def fits_print(width_cm, height_cm):\n    if width_cm < 0 and height_cm < 0:\n        return False\n    if width_cm < 0 and height_cm == 0:\n        return False\n    if width_cm < 0 and 0 < height_cm < 4:\n        return False\n    if width_cm < 0 and height_cm == 4:\n        return False\n    if width_cm < 0 and height_cm > 4:\n        return False\n    if width_cm == 0 and height_cm < 0:\n        return False\n    if width_cm == 0 and height_cm == 0:\n        return False\n    if width_cm == 0 and 0 < height_cm < 4:\n        return False\n    if width_cm == 0 and height_cm == 4:\n        return False\n    if width_cm == 0 and height_cm > 4:\n        return False\n    if 0 < width_cm < 6 and height_cm < 0:\n        return False\n    if 0 < width_cm < 6 and height_cm == 0:\n        return False\n    if 0 < width_cm < 6 and 0 < height_cm < 4:\n        return True\n    if 0 < width_cm < 6 and height_cm == 4:\n        return False\n    if 0 < width_cm < 6 and height_cm > 4:\n        return False\n    if width_cm == 6 and height_cm < 0:\n        return False\n    if width_cm == 6 and height_cm == 0:\n        return False\n    if width_cm == 6 and 0 < height_cm < 4:\n        return True\n    if width_cm == 6 and height_cm == 4:\n        return False\n    if width_cm == 6 and height_cm > 4:\n        return False\n    if width_cm > 6 and height_cm < 0:\n        return False\n    if width_cm > 6 and height_cm == 0:\n        return False\n    if width_cm > 6 and 0 < height_cm < 4:\n        return False\n    if width_cm > 6 and height_cm == 4:\n        return False\n    if width_cm > 6 and height_cm > 4:\n        return False\n    raise NotImplementedError"
