  "submission": "def allow_cancel(age_seconds, until_start_seconds):\n    # 일반 취소 마감 시간: 이용 시작 24시간 전\n    general_cancellation_cutoff = 24 * 60 * 60  # 24시간을 초로 변환\n    \n    # \"방금 잘못 예약한 고객에게는 별도의 정정 시간이 있습니다.\"에 대한 운영 기준\n    # 정정 시간: 예약 생성 후 10분까지는 일반 취소 마감이 지나도 허용\n    correction_time = 10 * 60  # 10분을 초로 변환\n\n    # 일반 취소 마감 기준\n    if until_start_seconds >= general_cancellation_cutoff:\n        # 일반 취소 마감 시간 이전에 취소가 가능\n        return True\n    elif until_start_seconds < 0:\n        # 이용이 이미 시작된 경우, 취소 불가\n        return False\n    else:\n        # 일반 취소 마감 시간 이후에 취소가 불가\n        # 하지만 예약 생성 후 10분 이내에는 허용\n        if age_seconds <= correction_time:\n            return True\n        else:\n            return False\n",
